# Bytecode
__pycache__/
*.pyc
*.pyo

# Environment
.env

# Outputs (generated media)
outputs/

# Runtime-generated prompt/job files (regenerated on demand)
pipeline/promptbank_*.json
pipeline/edited_prompts_*.json
pipeline/checkpoint_*.json

# Asset binaries
webui/fonts/*.ttf
webui/fonts/*.txt
webui/fonts/static/*.ttf

# Logs
*.log
*.err

# OS
Thumbs.db
.DS_Store

# IDE
.vscode/
.idea/

# Archived/unused items (see UNUSED FILES/README.md)
UNUSED FILES/

# Local settings with live API keys (track settings.json.example instead)
core/settings.json

# Runtime run history (regenerated on every run)
webui/activity.json
